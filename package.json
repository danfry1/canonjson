{
  "name": "canonjson",
  "version": "0.1.0",
  "description": "RFC 8785 (JCS) canonical JSON serialization and stable hashing of any JS value. Zero dependencies, ~1 KB.",
  "keywords": [
    "cache-key",
    "canonical",
    "canonicalize",
    "deterministic",
    "hash",
    "jcs",
    "json",
    "rfc8785",
    "signing",
    "stable",
    "stringify"
  ],
  "homepage": "https://github.com/danfry1/canonjson#readme",
  "bugs": {
    "url": "https://github.com/danfry1/canonjson/issues"
  },
  "license": "MIT",
  "author": "Daniel Fry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danfry1/canonjson.git"
  },
  "bin": {
    "canonjson": "bin/canonjson.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "node": [
        "./dist/node.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "bench": "bun run build && node bench/bench.mjs",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build",
    "prepublishOnly": "bun run check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:coverage": "vitest run --coverage",
    "knip": "knip"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.4.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.9.0",
    "knip": "6.32.1",
    "npm": "11.15.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
