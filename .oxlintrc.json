{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "promise", "node", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "nursery": "off"
  },
  "env": { "es2024": true, "node": true, "browser": true },
  "settings": {},
  "rules": {},
  "overrides": [
    {
      "files": ["test/**", "bench/**"],
      "rules": {}
    }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
